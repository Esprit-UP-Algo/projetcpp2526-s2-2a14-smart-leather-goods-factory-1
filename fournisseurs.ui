   <string notr="true">
/* GLOBAL BACKGROUND */
QMainWindow, QWidget#centralwidget { background-color: #f1e7dc; font-family: "Segoe UI"; }

/* TITRE PRINCIPAL */
QLabel#label_8 { font-size: 20px; font-weight: bold; color: #5b2f1d; letter-spacing: 1px; }

/* LABELS */
QLabel { color: #3a2a20; font-weight: 600; }

/* INPUTS */
QLineEdit, QComboBox { background-color: rgba(255, 250, 245, 0.6); border: 1px solid #c6a88d; border-radius: 6px; padding: 6px; color: #3a2a20; }
QLineEdit:focus, QComboBox:focus { border: 2px solid #6b3e26; background-color: #fffaf5; }

/* TABLEAU STYLE LEATHER */
QTableWidget { background-color: #fffaf5; border: 2px solid #b08a6b; border-radius: 14px; gridline-color: #e0d2c5; }
QHeaderView::section { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6b3e26, stop:1 #4a2717); color: #fffaf5; padding: 8px; border: none; font-weight: bold; }
QTableWidget::item:selected { background-color: #d8b59c; color: #2a1a12; }

/* BOUTONS STANDARDS (Buns Marron) */
QPushButton { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7a4a2e, stop:1 #5b2f1d); border: 2px solid #3a1f14; border-radius: 10px; padding: 8px 12px; font-weight: bold; color: #fffaf5; }
QPushButton:hover { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8b5a3a, stop:1 #6b3e26); }

/* BOUTONS ACCENTUÉS (Couleurs exactes de la page Machine) */
QPushButton#pushButton_3 { background-color: #6f8f3d; border-color: #4c6328; } /* Ajouter (Vert) */
QPushButton#pushButton_4 { background-color: #d07a2d; border-color: #a35d1e; } /* Modifier (Orange) */
QPushButton#pushButton_5 { background-color: #a23b2a; border-color: #6e2418; } /* Supprimer (Rouge) */
QPushButton#pushButton_6 { background-color: #7a4a2e; border-color: #3a1f14; } /* Actualiser (Marron) */

/* PAGINATION */
QPushButton#pushButton_10, QPushButton#pushButton_11, QPushButton#pushButton_12, QPushButton#pushButton_13, QPushButton#pushButton_14 { background-color: #a47148; border-color: #6b3e26; }
   </string>
